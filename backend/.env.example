# Flux Video Generator - Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION SETTINGS
# ============================================

# Application environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (True/False)
DEBUG=True

# Server host and port
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated list) - include the frontend Vite dev server
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# ============================================
# API KEYS (REQUIRED)
# ============================================

# Google Gemini API Key - REQUIRED for script generation (free tier) and image fallback
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Extra Gemini keys, comma-separated, no spaces. The free tier allows 20
# generate_content requests PER DAY per project and a render spends two, so one
# key runs out after about 10 videos. Each key from a DIFFERENT Google Cloud
# project adds its own daily allowance; the script generator rotates to the next
# one automatically when the current key reports its daily quota exhausted.
# Keys from the same project share one quota and add nothing.
#   GEMINI_API_KEYS=AIzaSy_SECOND_KEY,AIzaSy_THIRD_KEY
GEMINI_API_KEYS=

# Gemini model used for text generation (scripts, questions) - free tier
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Script provider: "gemini" (free tier, rate-limited) or "ollama" (local, free,
# unlimited). For ollama: install Ollama, run `ollama pull llama3.2`, then set:
#   SCRIPT_PROVIDER=ollama
SCRIPT_PROVIDER=gemini
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Pexels API Key - PRIMARY source for scene images (free)
# Get it from: https://www.pexels.com/api/
# If a topic returns no Pexels images, the app falls back to Gemini image generation
PEXELS_API_KEY=your_pexels_api_key_here

# ============================================
# BACKBLAZE B2 - DURABLE MEDIA STORAGE (REQUIRED for the hosted app)
# ============================================
#
# Flux is B2-first: every render (mp4 + thumbnail + captions + script +
# provenance manifest) is uploaded to B2 and served from there via short-lived
# presigned URLs. Local disk is scratch space, so the library survives restarts
# and redeploys on hosts with an ephemeral filesystem.
#
# Setup (free tier includes 10 GB):
#   1. Create an account: https://www.backblaze.com/sign-up/cloud-storage
#   2. B2 Cloud Storage -> Buckets -> Create a Bucket (set it PRIVATE)
#   3. Application Keys -> Add a New Application Key, scoped to that bucket,
#      with Read and Write access
#   4. Copy keyID -> B2_KEY_ID, applicationKey -> B2_APP_KEY (shown once)
#   5. The bucket's Endpoint looks like s3.us-west-004.backblazeb2.com
#      -> B2_REGION is the middle part: us-west-004
B2_KEY_ID=your_b2_key_id_here
B2_APP_KEY=your_b2_application_key_here
B2_BUCKET=your_b2_bucket_name_here
B2_REGION=us-west-004

# Key namespace inside the bucket (library artefacts + Genblaze runs live under it)
B2_PREFIX=flux

# Lifetime of presigned playback/download URLs handed to the browser (seconds)
B2_URL_TTL_SECONDS=3600

# Keep a local copy of the mp4 after a successful B2 upload. Leave false on
# ephemeral hosts; set true if you want the files on disk as well.
KEEP_LOCAL_COPY=false

# ============================================
# GENBLAZE - GENERATIVE ORCHESTRATION + PROVENANCE
# ============================================
#
# Genblaze records every render as a canonical, SHA-256-bound manifest written
# to B2 and embedded into the mp4, and can also drive the generative steps.
GENBLAZE_ENABLED=true

# Tenant namespace stamped on every run/manifest and used in the B2 key path
GENBLAZE_TENANT_ID=flux

# Bucket layout for Genblaze runs: hierarchical | content_addressable
GENBLAZE_KEY_STRATEGY=hierarchical

# Write the manifest into the mp4 container so the file carries its own record
GENBLAZE_EMBED_MANIFEST=true

# Also push every artefact through the Genblaze object-storage sink during the
# provenance ingest. Off by default: the storage stage already uploads the mp4,
# thumbnail, captions, script and the manifest itself to B2, so this re-uploads
# the same megabytes a second time and added ~15s to every render. The manifest
# is still built, verified and embedded either way.
GENBLAZE_SINK_ASSETS=false

# GMI Cloud key - OPTIONAL. Unlocks Genblaze cloud image/video/audio models.
# Setting this also lets narration run in the cloud, which keeps torch/Kokoro
# off the deployment host entirely. Get one at https://gmicloud.ai
GMI_API_KEY=

# Scene image source:
#   auto     -> Pexels (primary) then Gemini generation (fallback)  [default]
#   genblaze -> Genblaze generation first, still falling back to Pexels/Gemini
#   pexels   -> Pexels only
#   gemini   -> Gemini generation only
# Genblaze records provenance and owns B2 storage on every render regardless.
IMAGE_PROVIDER=auto

# Genblaze image model, routed by id:
#   gemini-*-image -> generateContent (needs GEMINI_API_KEY *with billing*;
#                     the free tier reports limit: 0 for image generation)
#   imagen-*       -> Imagen predict API — Google has CLOSED these to new keys
#   anything else  -> GMI Cloud (needs GMI_API_KEY), e.g. seedream-5.0-lite
# Without a billed Google key or a GMI key, visuals fall back to Pexels and
# Genblaze still records the provenance manifest.
GENBLAZE_IMAGE_MODEL=gemini-2.5-flash-image

# Narration backend:
#   auto     -> Genblaze (if GMI key) -> Edge TTS -> Kokoro   [default]
#   edge     -> Edge TTS: free, no API key, no local model
#   genblaze -> cloud TTS via GMI_API_KEY
#   kokoro   -> local, needs: pip install -r requirements-kokoro.txt
# Edge is the default: Kokoro pulls torch (~490 MB) plus a ~350 MB model and
# peaks near 1.5 GB, which OOM-kills small containers mid-render.
TTS_PROVIDER=auto

# Edge TTS voices. `edge-tts --list-voices` lists all 47 English options.
EDGE_TTS_VOICE_MALE=en-GB-RyanNeural
EDGE_TTS_VOICE_FEMALE=en-GB-SoniaNeural

GENBLAZE_TTS_MODEL=minimax-tts-speech-2.6-turbo
GENBLAZE_TTS_VOICE=

# ============================================
# VIDEO GENERATION SETTINGS
# ============================================

# Default video duration in seconds
DEFAULT_VIDEO_DURATION=60

# Default frames per second for video output
DEFAULT_VIDEO_FPS=20

# Default chunk size for subtitle splitting
DEFAULT_CHUNK_SIZE=10

# ============================================
# IMAGE SETTINGS (Pexels primary, Gemini fallback)
# ============================================

# Gemini image model used only when Pexels has no match (e.g. gemini-2.5-flash-image)
IMAGE_GEN_MODEL=gemini-2.5-flash-image

# Image aspect ratio (1:1, 3:4, 4:3, 9:16, 16:9) - maps to Pexels orientation.
# Keep this in the same orientation as the output video (FLUX_VIDEO_WIDTH/HEIGHT,
# vertical by default). Scene images are cover-cropped to the video frame anyway,
# so a mismatched shape crops away more of the photo AND searches a much smaller,
# worse-matched stock pool — with 1:1 against a vertical video, "Indian rupee
# banknotes" returned Turkish lira. A contradicting value is overridden at runtime.
IMAGE_ASPECT_RATIO=9:16

# Delay between image API calls (seconds)
IMAGE_GEN_DELAY=2.0

# ============================================
# TRENDING PIPELINE (Economic Times RSS -> short-form video)
# ============================================

# Master switch. When true, a background scheduler fetches ET feeds, ranks
# articles, and auto-generates the top N short videos on an interval.
# NOTE: enabling this consumes Gemini quota (and uploads to YouTube if
# TRENDS_AUTO_PUBLISH=true) unattended. Leave false until you're ready.
TRENDS_ENABLED=false

# Economic Times RSS feeds to monitor (comma-separated)
TRENDS_FEED_URLS=https://economictimes.indiatimes.com/rssfeedstopstories.cms,https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,https://economictimes.indiatimes.com/industry/rssfeeds/13352306.cms,https://economictimes.indiatimes.com/news/economy/rssfeeds/1373380680.cms,https://economictimes.indiatimes.com/tech/rssfeeds/13357270.cms

# How often to run the pipeline (hours)
TRENDS_INTERVAL_HOURS=6

# How many top-ranked articles to turn into videos each run
TRENDS_TOP_N=3

# Short-form video duration (seconds)
TRENDS_VIDEO_DURATION=60

# Ignore articles older than this many hours
TRENDS_MAX_AGE_HOURS=24

# Auto-publish trending videos to YouTube (uses YOUTUBE_PRIVACY_STATUS = private)
TRENDS_AUTO_PUBLISH=false

# Run one pipeline pass immediately on server startup (otherwise waits one interval)
TRENDS_RUN_ON_STARTUP=false

# ============================================
# YOUTUBE AUTO-PUBLISHING
# ============================================

# OAuth credentials live in backend/secrets/ (gitignored):
#   secrets/youtube_client_secret.json  - OAuth "installed app" client
#   secrets/youtube_token.json          - authorized token (with refresh_token)
# Auto-publish is opt-in per render via the toggle in the UI.

# Privacy for auto-published videos (private, unlisted, public). Keep "private" for now.
YOUTUBE_PRIVACY_STATUS=private

# YouTube category id (25 = News & Politics, 27 = Education)
YOUTUBE_CATEGORY_ID=25

# Default tags applied to uploads (comma-separated)
YOUTUBE_DEFAULT_TAGS=indian stock market,sensex,nifty,business news,markets,finance india

# ============================================
# TTS (TEXT-TO-SPEECH) SETTINGS
# ============================================

# TTS language code (b for English)
TTS_LANG_CODE=b

# ============================================
# FILE UPLOAD SETTINGS
# ============================================

# Maximum upload size in bytes (50MB default)
MAX_UPLOAD_SIZE=52428800

# ============================================
# BACKGROUND TASK SETTINGS
# ============================================

# Task timeout in seconds (10 minutes default)
TASK_TIMEOUT=600

# ============================================
# LOGGING SETTINGS
# ============================================

# Log file name
LOG_FILE=app.log

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
